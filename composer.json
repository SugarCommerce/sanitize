{
  "name": "sugarcommerce/sanitize",
  "version": "1.5.0",
  "description": "Untrusted strings in, something safe to store out. Control characters and display-spoofing Unicode stripped, addresses and URLs validated, integers clamped, allow-lists for the values that reach SQL as identifiers. Zero dependencies.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/sanitize",
  "authors": [ { "name": "David Sherlock", "homepage": "https://arraypress.com/" } ],
  "keywords": ["sanitisation", "sanitization", "validation", "security", "input"],
  "require": { "php": ">=8.5" },
  "require-dev": { "phpunit/phpunit": "^13.0" },
  "autoload": { "psr-4": { "SugarCommerce\\Sanitize\\": "src/" } },
  "autoload-dev": { "psr-4": { "SugarCommerce\\Sanitize\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit" },
  "config": { "optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist" },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": { "issues": "https://github.com/sugarcommerce/sanitize/issues", "source": "https://github.com/sugarcommerce/sanitize" }
}
